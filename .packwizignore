# packwiz indexes EVERY on-disk file unless ignored here. The client pack is ONLY:
#   mods/*.pw.toml + resourcepacks/*.pw.toml (metafiles) and the committed overrides/ tree.
# Everything else in this repo is dev/server/build junk and must be excluded, or packwiz tries to
# serve it from raw GitHub and 404s (the "141 errored" / client-mods-temp 404 bugs).

# Server install + test instances
server-files/
server/
server-test/
server-mods/
dist/

# WIP assets not referenced by any shipped layout (animated-cogwheel feature unshipped)
overrides/config/fancymenu/assets/cogwheel_spin_cw.png
overrides/config/fancymenu/assets/cogwheel_spin_ccw.png

# Staging / temp mod folders (jars are delivered via the mods/*.pw.toml metafiles, not raw overrides)
client-mods-temp/
client-mods-temp.zip
overrides/mods/
overrides/resourcepacks/

# Server-only secret config — must never ship to clients
overrides/config/velocity/

# Docs vault (decoy copy) + source + build artifacts
obsidian-vault/
Menu asssets/
src/
build/
reports/
scripts/
docs/

# IDE / tooling
.claude/
.idea/
*.iml

