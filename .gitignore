.obsidian/workspace.json
.obsidian/cache

# Gradle build output / cache (custom mods)
build/
.gradle/

# Local test server — contains world data, logs, and forwarding secrets. Never commit.
/server-test/

# Local server runtime copy — world, logs, libraries, ops/usercache, installers, secrets.
# Only the tuned configs + the lobby schematic are force-added (see below); the rest is ignored.
/server-files/
/server/

# Pack build artifacts
*.mrpack
client-mods-temp/
client-mods-temp.zip
nf_versions.json

# Secrets — only the .env.example template is committed
.env

# IDE
*.iml
run/

# Internal docs / tooling — never commit to the public repo
CLAUDE.md
obsidian-vault/
reports/
.idea/
.claude/

# jars/packs ship via releases+CDN, never git
overrides/mods/
overrides/resourcepacks/
overrides/shaderpacks/
.cf-key

# Runtime server/client logs — never commit (player IPs, chat, auth events).
# 2026-08-10: logs/ had leaked into the packwiz index and shipped to every client.
logs/
**/logs/
index.toml.bak-*
pack.toml.bak-*

# Local-only build/deploy staging — NEVER commit (847 MB of jars, and the packwiz updater
# pulls this repo raw). CLAUDE.md lists both as excluded; they had never been tracked.
server-mods/
dist/

# Votifier / crypto keys — NEVER commit (repo is public)
*.key
*.pem
private.key

# Local staging + downloaded logs (server IPs, chat, auth events)
Releases/
*.log

# Compile-only mod jars for mixin/API signatures. NEVER commit these — the repo is PUBLIC
# and create.jar alone is 19 MB of somebody else's redistributed binary.
# Refresh from overrides/mods/ and create's META-INF/jarjar/ when they need updating.
src/*/libs/
