# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit it.

# ── MySQL (CoffeesAeroAuth profile/credential store) ───────────────────────
# If DB_USER is left blank, the mod falls back to flat-file storage.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=coffeesaero
DB_USER=
DB_PASSWORD=

# ── Velocity ↔ backend forwarding secret ───────────────────────────────────
# Must match AERO_FORWARDING_SECRET set on the AeroVelocity proxy. Used to reject
# spoofed aerosmp:player_type messages. Leave blank for LOCAL TESTING ONLY.
AERO_FORWARDING_SECRET=

# ── Obsidian Local REST API (community plugin required) ────────────────────
OBSIDIAN_URL=http://localhost:27123
OBSIDIAN_API_KEY=<your-obsidian-local-rest-api-key>
