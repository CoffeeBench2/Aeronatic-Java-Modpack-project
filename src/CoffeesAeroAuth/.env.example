# CoffeesAeroAuth — environment variables
# Copy this to .env in the server root directory and fill in the values.
# NEVER commit the actual .env file to source control.

# ── MySQL database ────────────────────────────────────────────────────────────
# If DB_USER is empty, the mod falls back to flat-file storage automatically.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=coffeesaero
DB_USER=
DB_PASSWORD=

# ── Obsidian Live Sync ────────────────────────────────────────────────────────
OBSIDIAN_URL=http://localhost:27123
OBSIDIAN_API_KEY=

# ── Discord ───────────────────────────────────────────────────────────────────
# DISCORD_BOT_TOKEN and webhook URLs can also be set in the mod config file.
# Values here override config.
# DISCORD_BOT_TOKEN=
# DISCORD_WEBHOOK_PUBLIC=
# DISCORD_WEBHOOK_WATCHDOG=

# ── Velocity proxy forwarding ───────────────────────────────────────────────────
# Shared secret the AeroVelocity proxy echoes in its aerosmp:player_type message so
# this backend can trust the premium/cracked signal. MUST match the proxy's
# AERO_FORWARDING_SECRET env var. Leave blank ONLY for local testing — set a strong
# random value on any public server, or cracked clients can spoof "premium" and skip login.
AERO_FORWARDING_SECRET=
